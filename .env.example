# Copy to .env and fill in. Never commit real secrets.
# These override values in config.yaml.

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage (optional overrides) ---
# KIKO_STORAGE_BACKEND=sqlite
# KIKO_SQLITE_PATH=data/kiko.db
# KIKO_POSTGRES_DSN=postgresql://user:pass@localhost:5432/kiko

# --- Scraping (optional overrides) ---
# KIKO_MIN_DELAY=2.0
# KIKO_MAX_DELAY=3.0
# KIKO_CATEGORY_URLS=https://www.noon.com/saudi-en/deals/

# --- Misc ---
# KIKO_CONFIG=config.yaml
# KIKO_LOG_LEVEL=INFO
